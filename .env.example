# ── Database ────────────────────────────────────────────────────────────────
# Pooled connection URL (used at runtime — Neon: use the -pooler endpoint)
DATABASE_URL="your_database_url_here"

# Direct (non-pooled) connection URL (used by Prisma Migrate)
# Neon: same as above but without the -pooler subdomain
DIRECT_URL="your_direct_database_url_here"

# ── Auth0 ────────────────────────────────────────────────────────────────────
AUTH0_DOMAIN="your-tenant.us.auth0.com"
AUTH0_CLIENT_ID="your_client_id"
AUTH0_CLIENT_SECRET="your_client_secret"
# 64-character secret used to encrypt the session cookie
# Generate with: openssl rand -hex 32
AUTH0_SECRET="replace_with_64_char_random_hex"

# Auth0 Machine-to-Machine app credentials for deleting users from Auth0.
# The M2M app must be authorized for the Auth0 Management API with delete:users.
AUTH0_MANAGEMENT_CLIENT_ID="your_m2m_client_id"
AUTH0_MANAGEMENT_CLIENT_SECRET="your_m2m_client_secret"
# Optional. Defaults to AUTH0_DOMAIN when omitted.
AUTH0_MANAGEMENT_DOMAIN="your-tenant.us.auth0.com"

# ── App ──────────────────────────────────────────────────────────────────────
# Base URL of your deployed app (no trailing slash). REQUIRED in production.
APP_BASE_URL="https://your-app.vercel.app"
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"

# ── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_ENV="test"
STRIPE_SECRET_KEY_TEST="sk_test_..."
STRIPE_PRO_PRICE_ID_TEST="price_..."
STRIPE_WEBHOOK_SECRET_TEST="whsec_..."
STRIPE_SECRET_KEY_LIVE="sk_live_..."
STRIPE_PRO_PRICE_ID_LIVE="price_..."
STRIPE_WEBHOOK_SECRET_LIVE="whsec_..."

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY="re_..."

# ── Cron ─────────────────────────────────────────────────────────────────────
# Secret used to authenticate Vercel cron job requests.
# Generate with: openssl rand -hex 32
CRON_SECRET="replace_with_random_hex"

# ── Email unsubscribe ─────────────────────────────────────────────────────────
# HMAC key for stateless unsubscribe tokens. Must be independent of AUTH0_SECRET.
# Generate with: openssl rand -hex 32
UNSUBSCRIBE_SECRET="replace_with_random_hex"

# ── Shareable plan links ───────────────────────────────────────────────────────
# HMAC key for signing stateless share tokens (/plan/[token] public pages).
# Generate with: openssl rand -hex 32
SHARE_TOKEN_SECRET="replace_with_random_hex"

# ── AI (Anthropic) ───────────────────────────────────────────────────────────
ANTHROPIC_API_KEY="sk-ant-..."

# ── Upstash Redis (rate limiting) ─────────────────────────────────────────────
# Get from console.upstash.com — create a Redis database, copy these values.
UPSTASH_REDIS_REST_URL="https://your-db.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_token"

# ── Analytics (PostHog) ───────────────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY="phc_..."
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"

# ── Content ──────────────────────────────────────────────────────────────────
# Optional: Google Sheets URL for featured content
CONTENT_SHEET_URL="https://docs.google.com/spreadsheets/d/..."

# ── Plaid (bank linking) ──────────────────────────────────────────────────────
PLAID_CLIENT_ID="your_client_id"
PLAID_SECRET="your_secret"
PLAID_ENV="sandbox" # or "production"
# 64-character hex key used to encrypt stored access tokens (AES-256-GCM).
# Generate with: openssl rand -hex 32
PLAID_TOKEN_ENCRYPTION_KEY="replace_with_64_char_random_hex"
# Production only — required for real bank OAuth (Chase, BofA, etc). See PLAID_SETUP.md.
# PLAID_REDIRECT_URI="https://your-app.vercel.app/plaid/oauth-return"
# Where Plaid POSTs item webhooks. Leave unset in local dev (no public callback URL).
# PLAID_WEBHOOK_URL="https://your-app.vercel.app/api/plaid/webhooks"
# First-10 rollout gate: comma-separated emails allowed to use Plaid (every real
# call costs money). Fails closed — unset means nobody gets access, so add your
# own email here before testing/deploying. Not required in sandbox if you don't
# need the gate locally, but must be set in production.
# PLAID_ALLOWED_EMAILS="you@example.com,friend@example.com"
# Max linked institutions (Plaid Items) per user — anti-abuse cost cap, not a
# product limit. Defaults to 10; bump here if a legitimate user hits it (the
# server logs "[plaid] item cap reached" when that happens).
# PLAID_MAX_ITEMS_PER_USER="10"
