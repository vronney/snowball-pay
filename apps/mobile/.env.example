# EXPO_PUBLIC_* values are bundled into the app — public identifiers only, never secrets.
# For EAS builds, set the same keys as EAS environment variables (eas env:create).
EXPO_PUBLIC_API_URL="https://getsnowballpay.com"
# Auth0 Native application (NOT the web app's Regular Web Application client).
# Allowed Callback URLs must include: snowballpay://auth/callback
EXPO_PUBLIC_AUTH0_DOMAIN="your-tenant.us.auth0.com"
EXPO_PUBLIC_AUTH0_CLIENT_ID="your_native_client_id"
# Auth0 API identifier. Must equal AUTH0_MOBILE_AUDIENCE on the Next.js side.
EXPO_PUBLIC_AUTH0_AUDIENCE="https://api.getsnowballpay.com"
